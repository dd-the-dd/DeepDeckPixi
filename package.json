{
  "name": "@deepdeck/pixi",
  "version": "0.1.0",
  "description": "Reusable PixiJS game renderer, session projection and replay host for DeepDeckEngine",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/**/*.d.mts"
  ],
  "main": "./dist/deepdeck-pixi.js",
  "module": "./dist/deepdeck-pixi.js",
  "types": "./src/index.d.mts",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./dist/deepdeck-pixi.js"
    },
    "./replay-element": {
      "types": "./src/shared/PixiReplayV2Element.d.mts",
      "import": "./src/shared/PixiReplayV2Element.mjs"
    },
    "./source/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "pixi.js": "^7.4.3",
    "vue": "^3.5.31"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.6.1",
    "@vitejs/plugin-vue": "6.0.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "9.39.2",
    "eslint-plugin-vue": "10.6.2",
    "happy-dom": "^20.8.9",
    "pixi.js": "^7.4.3",
    "sass": "^1.97.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue": "^3.5.31"
  },
  "engines": {
    "node": ">=22.12"
  }
}
